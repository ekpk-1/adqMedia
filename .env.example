# Contact form (https://resend.com). Without a key, enquiries are logged in
# development and rejected with a friendly error in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="ADQ Media <enquiries@adqmedia.au>"

# Sanity. The site keeps reading the files in the repo until a project exists in the dataset.
# Create the project at https://www.sanity.io/manage, then add the local dev origin and the
# Vercel domain to its CORS origins. The write token is used by the migration script only.
# Films stay as files in public/. Sanity stores the path.
# SANITY_API_READ_TOKEN previews drafts in Studio. A viewer token is enough.
# The write token is only for the migration script. It is used for preview if the read token is empty.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
